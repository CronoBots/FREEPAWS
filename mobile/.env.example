# Copier en .env.local (jamais commité) et remplir avec les valeurs du projet Supabase.
# Dashboard Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxx
# Compte de démonstration pour les reviewers Apple/Google (connexion par mot de passe).
EXPO_PUBLIC_REVIEW_EMAIL=review@freepaws.be
# Adresse web de l'app publiée (liens envoyés aux invités et aux secours). Facultatif.
EXPO_PUBLIC_APP_URL=
